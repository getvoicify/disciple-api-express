    "express": "^5.1.0",
    "glob": "^11.0.3",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "js-yaml": "^4.1.0",
    "multer": "^2.0.2",
    "postgres": "^3.4.7",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.29.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.9"
  }
